{
  "name": "@the-forum/database",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env run src/ensure-extensions.ts && bun --env-file=../../.env run drizzle-kit push",
    "db:studio": "bun --env-file=../../.env run drizzle-kit studio",
    "db:seed": "bun --env-file=../../.env run src/seed.ts",
    "db:seed:org-review": "bun --env-file=../../.env run src/seed-org-review.ts",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "db:sync-engine": "bun --env-file=../../.env run src/sync-inbox-engine.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.3"
  }
}
